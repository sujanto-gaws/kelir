  "query": "\n        SELECT r.id, r.role_code, r.name\n        FROM user_roles ur\n        JOIN roles r ON r.id = ur.role_id AND r.deleted_at IS NULL\n        WHERE ur.user_id = $1 AND ur.deleted_at IS NULL\n        ORDER BY r.role_code\n        ",
