  "query": "\n        SELECT id, document_id, event_type, event_category, actor_user_id, actor_name,\n               action_summary, details_json, created_at\n        FROM activity_events\n        WHERE tenant_id = $1 AND document_id = $2\n        ORDER BY created_at DESC, id DESC\n        LIMIT $3 OFFSET $4\n        ",
