{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT id, role_code, name, description, is_system\n        FROM roles\n        WHERE tenant_id = $1\n          AND deleted_at IS NULL\n          AND ($2::text IS NULL OR role_code ILIKE $2 OR name ILIKE $2)\n        ORDER BY role_code\n        LIMIT $3 OFFSET $4\n        ",
