{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT id, type_code, name, category, form_id, status, created_at, updated_at\n        FROM document_types\n        WHERE tenant_id = $1\n          AND deleted_at IS NULL\n          AND ($2::text IS NULL OR type_code ILIKE $2 OR name ILIKE $2)\n          AND ($3::text IS NULL OR status = $3)\n        ORDER BY type_code\n        LIMIT $4 OFFSET $5\n        ",
