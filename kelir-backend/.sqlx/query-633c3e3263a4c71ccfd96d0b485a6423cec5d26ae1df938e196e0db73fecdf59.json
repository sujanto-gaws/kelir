{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT id, list_key, title, entity_id, page_size, status, created_at, updated_at\n        FROM rad_lists\n        WHERE tenant_id = $1\n          AND deleted_at IS NULL\n          AND ($2::text IS NULL OR list_key ILIKE $2 OR title ILIKE $2)\n          AND ($3::text IS NULL OR status = $3)\n        ORDER BY list_key\n        LIMIT $4 OFFSET $5\n        ",
