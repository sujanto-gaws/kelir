  "query": "\n        SELECT id, form_key, title, revision, jfss_version, status, entity_id,\n               created_at, updated_at\n        FROM rad_forms\n        WHERE tenant_id = $1 AND deleted_at IS NULL\n        ORDER BY form_key, revision DESC\n        LIMIT $2 OFFSET $3\n        ",
