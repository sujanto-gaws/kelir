  "db_name": "PostgreSQL",
  "query": "\n        SELECT id, document_id, workflow_instance_id, task_id, notification_type,\n               title, body, read_at, created_at\n        FROM notifications\n        WHERE tenant_id = $1 AND recipient_user_id = $2 AND deleted_at IS NULL\n        ORDER BY created_at DESC, id DESC\n        LIMIT $3 OFFSET $4\n        ",
