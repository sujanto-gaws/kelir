{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT t.id, t.tenant_code, t.name, t.status, t.created_at,\n               (\n                   SELECT count(*)\n                   FROM users u\n                   WHERE u.tenant_id = t.id AND u.deleted_at IS NULL\n               ) AS \"user_count!\"\n        FROM tenants t\n        WHERE t.deleted_at IS NULL\n        ORDER BY t.created_at DESC, t.tenant_code\n        LIMIT $1 OFFSET $2\n        ",
