{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT d.status, d.form_data_json, d.document_type_id, t.type_code\n        FROM documents d\n        JOIN document_types t ON t.id = d.document_type_id AND t.tenant_id = d.tenant_id\n        WHERE d.tenant_id = $1 AND d.id = $2 AND d.deleted_at IS NULL\n        ",
