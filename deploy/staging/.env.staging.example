# Staging secrets for kelir-staging-01.
#
# Copy to `.env` beside docker-compose.staging.yml and fill in real values.
# Never commit the filled-in file: `.gitignore` already excludes `.env`.
#
# Generate each secret rather than inventing one, for example:
#   openssl rand -base64 36
#
# The backend refuses to start in staging on a placeholder JWT secret, so a
# copied-and-unedited file fails fast instead of running forgeable tokens.

# The release being deployed. Matches the git tag without the leading "v".
KELIR_VERSION=0.1.0

# PostgreSQL password for the `kelir` role on the host's native PostgreSQL.
# provision-ubuntu-24.sh generates this and writes it here on first run — only
# fill it in by hand if you are rotating it (change it in PostgreSQL too).
KELIR_DB_PASSWORD=

# Signs session tokens. Rotating it invalidates every active session.
KELIR_JWT_SECRET=

# MinIO root credentials for attachment storage (used from Phase 6).
KELIR_MINIO_USER=
KELIR_MINIO_PASSWORD=

# Reverse-proxy hops in front of the backend. Not a secret — listed here because
# it is topology, and getting it wrong is a security change rather than an
# outage.
#
# 1 matches this stack: Caddy is the only hop, it trusts no upstream (see
# Caddyfile), and no backend port is published, so nothing else can reach it.
# Leave it alone unless you put something else in front of Caddy; the compose
# file already defaults to 1.
KELIR_TRUSTED_PROXY_HOPS=1

# The first-run administrator, created only when the deployment has no users at
# all. Leave them empty on a deployment that already has one — the bootstrap is
# a no-op once any user exists, and the account it would create must change its
# password at first sign-in anyway.
#
# **A fresh deployment with these unset serves an application nobody can enter.**
# The backend says so at startup rather than failing, because a deployment may
# intend to create its first user another way. It went unnoticed until the
# release stack was run for the first time on 2026-08-21: the variables reached
# the host but were never passed into the container.
KELIR_BOOTSTRAP_ADMIN_USERNAME=
KELIR_BOOTSTRAP_ADMIN_PASSWORD=
KELIR_BOOTSTRAP_ADMIN_EMAIL=
