# Staging secrets for kelir-staging-01.
#
# Copy to `.env` beside docker-compose.staging.yml and fill in real values.
# Never commit the filled-in file: `.gitignore` already excludes `.env`.
#
# Generate each secret rather than inventing one, for example:
#   openssl rand -base64 36
#
# The backend refuses to start in staging on a placeholder JWT secret, so a
# copied-and-unedited file fails fast instead of running forgeable tokens.

# The release being deployed. Matches the git tag without the leading "v".
KELIR_VERSION=0.1.0

# PostgreSQL password for the `kelir` role on the host's native PostgreSQL.
# provision-ubuntu-24.sh generates this and writes it here on first run — only
# fill it in by hand if you are rotating it (change it in PostgreSQL too).
KELIR_DB_PASSWORD=

# Signs session tokens. Rotating it invalidates every active session.
KELIR_JWT_SECRET=

# MinIO root credentials for attachment storage (used from Phase 6).
KELIR_MINIO_USER=
KELIR_MINIO_PASSWORD=
