# Reverse proxy for a deployed Kelir stack.
#
# One origin for the whole application: the static bundle at `/`, and the API
# paths proxied to the backend container. Because the browser only ever sees one
# host, CORS does not apply to a deployed environment at all — it remains a
# local-development concern only — and Phase 2's session cookies stay same-site.
#
# The site address comes from the environment so the same file serves both
# deployment shapes:
#
#   KELIR_SITE_ADDRESS=staging.kelir.gawshub.com   a real hostname; Caddy obtains
#                                                  and renews the certificate
#                                                  automatically (NFR-SEC-010)
#   KELIR_SITE_ADDRESS=:8080                       an IP-reachable port for local
#                                                  testing; Caddy serves plain
#                                                  HTTP, because certificates
#                                                  cannot be issued for an IP
#
# Caddy decides between the two on the shape of the address — a bare port never
# triggers ACME — so no separate configuration is needed.

{
	# Where Let's Encrypt sends expiry and problem notices. Unused when the site
	# address is a bare port, since no certificate is requested.
	email ops@gawshub.com

	servers {
		# Caddy is the edge: nothing sits in front of it, so no X-Forwarded-For
		# arriving from outside may be believed. Naming only loopback — which
		# nothing but Caddy itself can connect from — means every incoming chain
		# is discarded and replaced with the address Caddy actually saw.
		#
		# Stated rather than left to the default because the default has changed:
		# Caddy appended to the incoming header before 2.7, which let a caller
		# plant the leftmost entry the backend read. The image is pinned to one
		# Caddy release since #590, but a bump moves the default with it, so
		# the trust boundary is written down instead of inherited.
		trusted_proxies static 127.0.0.1/32 ::1/128
	}
}

{$KELIR_SITE_ADDRESS:staging.kelir.gawshub.com} {
	encode zstd gzip

	# API and operational endpoints go to the backend. These paths must match
	# the backend router: /api/v1 plus the root-level operational endpoints
	# (naming convention §5).
	@backend path /api/* /health /health/* /version
	handle @backend {
		# X-Forwarded-For reaching the backend holds exactly one entry — the
		# address Caddy saw — because no upstream is trusted (see the global
		# block). The backend is configured with KELIR_TRUSTED_PROXY_HOPS=1 to
		# match: one hop, this one.
		reverse_proxy backend:8080
	}

	# Everything else is the single-page app. try_files sends unknown paths to
	# index.html so client-side routes such as /login survive a page refresh.
	#
	# `.vite` is hidden because the build writes a manifest there — the chunk
	# graph, keyed by source module path — for the CI step that holds decision
	# D-10's bundle condition (`scripts/check-bundle-split.mjs`). It is build
	# metadata rather than application content and has no business being served.
	#
	# **Caching (#771): a hashed file is kept for a year, everything else is
	# revalidated.** Vite names every file under /assets/ by a hash of its
	# content, so a URL there never changes what it answers: a new build makes
	# new names, and a browser may keep such a file for good. The document that
	# names them, index.html, is what must be fresh after a deploy, so it is
	# `no-cache`: kept, but asked about before each use, which its ETag makes a
	# 304 rather than a download. With neither header a browser guesses a
	# freshness from Last-Modified, and #721's measurement watched Chromium
	# refetch a lazy chunk once that guess ran out.
	#
	# **`file` is load-bearing.** try_files answers a missing path with
	# index.html, so a request for a chunk an earlier deploy removed gets the
	# document. Matched on `path /assets/*` alone, that answer would be kept for
	# a year under the chunk's URL — the stale page this header exists to
	# prevent. `file` asks, before the rewrite, whether the path is a file on
	# disk, so only a real hashed file is `immutable` and the fallback is
	# `no-cache`. The two matchers are each other's negation, so exactly one
	# header applies to any request this handle serves.
	#
	# `no-cache` therefore covers index.html at `/`, at `/index.html` and under
	# every client route, and `/version.json`, which is unhashed and changes
	# with every build (deploy.sh reads it to tell which image is serving).
	# Both headers are set inside this handle only, so the backend's paths
	# above get none from Caddy and keep whatever the backend sends.
	@hashed_asset {
		path /assets/*
		file
	}
	@not_hashed_asset not {
		path /assets/*
		file
	}
	handle {
		root * /srv
		header @hashed_asset Cache-Control "public, max-age=31536000, immutable"
		header @not_hashed_asset Cache-Control "no-cache"
		try_files {path} /index.html
		file_server {
			hide .vite
		}
	}

	# Baseline hardening. A stricter Content-Security-Policy belongs with the
	# security pass in Sprint 19, once the asset origins are settled.
	#
	# HSTS is sent unconditionally: browsers ignore it on a plain-HTTP response
	# by specification, so it costs nothing when the site address is a bare port
	# and protects the real hostname when it is not.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	log {
		output stdout
		format console
	}
}
