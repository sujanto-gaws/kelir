# Backend
KELIR_APP_NAME=Kelir
KELIR_APP_ENV=development
KELIR_DATABASE_URL=postgres://postgres:postgres@localhost:5432/kelir
KELIR_JWT_SECRET=change-me
KELIR_STORAGE_DRIVER=local
KELIR_SMTP_HOST=localhost
KELIR_FRONTEND_URL=http://localhost:5173

# Frontend
VITE_KELIR_API_BASE_URL=http://localhost:8080/api/v1
VITE_KELIR_APP_TITLE=Kelir

# Compose host ports
#
# Only the host side is configurable; container ports are fixed. Override these
# when another project already holds a port — the defaults below are what the
# stack uses when nothing is set. Compose reads these from the environment or
# from a .env file next to docker-compose.yml, not from this file.
KELIR_FRONTEND_PORT=5173
KELIR_BACKEND_PORT=8080
KELIR_POSTGRES_PORT=5432
KELIR_MINIO_PORT=9000
KELIR_MINIO_CONSOLE_PORT=9001
KELIR_SMTP_PORT=1025
KELIR_MAILPIT_UI_PORT=8025
