# Backend
KELIR_APP_NAME=Kelir
KELIR_APP_ENV=development
KELIR_DATABASE_URL=postgres://postgres:postgres@localhost:5432/kelir
KELIR_JWT_SECRET=change-me
KELIR_STORAGE_DRIVER=local
KELIR_SMTP_HOST=localhost
# The sender on outbound mail -- today only the password-reset link (FR-AUTH-006).
# An empty KELIR_SMTP_HOST turns sending into a log line rather than a startup
# failure, so a deployment without a mail server still runs.
KELIR_MAIL_FROM=no-reply@kelir.local
# Reset links are built against this, so it must be the address a person's
# browser can actually reach.
KELIR_FRONTEND_URL=http://localhost:5173

# Tenancy (FR-IDM-009). Off, sign-in resolves KELIR_DEFAULT_TENANT_CODE and the
# login request needs no tenant field — the single-tenant default, and how every
# deployment runs today. On, each sign-in must name its tenant in the request
# body, and that tenant must exist and be ACTIVE.
#
# The default code must match a row in `tenants`; SYSTEM is the one 0001_core.sql
# seeds. Pointing it at a tenant that does not exist fails startup rather than
# silently creating the first administrator somewhere else.
#
# Multi-tenant mode is not supported yet and the backend refuses to start with
# it on: nothing resolves a tenant per request, so sign-in would demand a code
# no client can send. Decision D-7 keeps a deployment single-tenant until that
# half exists.
KELIR_MULTI_TENANT=false
KELIR_DEFAULT_TENANT_CODE=SYSTEM


# How many reverse-proxy hops sit in front of the backend.
#
# 0 — the default, and what a direct local run wants — ignores X-Forwarded-For
# entirely and takes the caller's address from the socket. Anything higher tells
# the backend to skip that many hops from the right of the chain and believe the
# entry before them, so it must match the real topology: set 1 only when exactly
# one proxy you operate can reach the backend. Too high and a caller can pick
# their own address, which is their own rate-limit bucket and their own line in
# the audit trail.
KELIR_TRUSTED_PROXY_HOPS=0

# First administrator. Created once, at startup, only when the `users` table is
# empty — a fresh database otherwise has every permission defined and nobody
# able to use them. Both values are required together; leaving them unset is
# fine if the first user will be created another way. The password is held to
# the same 12-character minimum as every password the API sets, and the account
# it creates must change it after signing in. Unset all three once the first
# sign-in has succeeded.
KELIR_BOOTSTRAP_ADMIN_USERNAME=admin
KELIR_BOOTSTRAP_ADMIN_PASSWORD=
KELIR_BOOTSTRAP_ADMIN_EMAIL=admin@localhost

# Frontend
VITE_KELIR_API_BASE_URL=http://localhost:8080/api/v1
VITE_KELIR_APP_TITLE=Kelir

# Compose host ports
#
# Only the host side is configurable; container ports are fixed. Override these
# when another project already holds a port — the defaults below are what the
# stack uses when nothing is set. Compose reads these from the environment or
# from a .env file next to docker-compose.yml, not from this file.
KELIR_FRONTEND_PORT=5173
KELIR_BACKEND_PORT=8080
KELIR_POSTGRES_PORT=5432
KELIR_MINIO_PORT=9000
KELIR_MINIO_CONSOLE_PORT=9001
# Doubles as the backend's connect port: a backend run natively against this
# file reaches mailpit on localhost at whatever the host mapping publishes.
KELIR_SMTP_PORT=1025
KELIR_MAILPIT_UI_PORT=8025
