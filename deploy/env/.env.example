# Backend
KELIR_APP_NAME=Kelir
KELIR_APP_ENV=development
KELIR_DATABASE_URL=postgres://postgres:postgres@localhost:5432/kelir
KELIR_JWT_SECRET=change-me
KELIR_STORAGE_DRIVER=local

# Where attachments go (FR-ATT-001, #244). The defaults are the compose stack's
# MinIO, so `deploy/docker` gives working attachments with nothing set here.
#
# **The bucket must already exist.** This process is given credentials that can
# put and get objects in one; it does not create buckets, because a process that
# can create buckets can create the one an attacker names. The compose stack's
# `minio-init` service creates it, and CI's backend job does the same.
#
# A deployment that leaves object storage unconfigured still boots and still
# serves every other route — uploads are refused with a message naming these
# variables, and nothing pretends the bytes were stored.
KELIR_STORAGE_ENDPOINT=http://localhost:9000
KELIR_STORAGE_BUCKET=kelir
KELIR_STORAGE_ACCESS_KEY=minioadmin
KELIR_STORAGE_SECRET_KEY=minioadmin
KELIR_STORAGE_REGION=us-east-1

# What may be uploaded (FR-ATT-004, FR-ATT-005, #245). **Both are limits an
# operator sets, not constants in the code**, which is #245 AC5.
#
# The size is refused **on the request body, before any of it is read** — a
# limit applied to bytes already accepted is a limit on your disk. 25 MB is the
# default and it is the figure the virus scanner is sized against: a file this
# accepts and the scanner cannot hold is a file stuck at PENDING for ever, so
# move the two together.
KELIR_STORAGE_MAX_UPLOAD_BYTES=26214400

# Types are matched against what the file **is** — its leading bytes — and never
# against the extension or the Content-Type the caller sent, because those are
# text the caller wrote. Comma-separated.
#
# **An empty list refuses everything**, deliberately: the failure direction for a
# misconfigured allow-list is to store nothing rather than to store anything. A
# file whose type is not recognised at all is refused for the same reason.
KELIR_STORAGE_ALLOWED_MIME_TYPES=application/pdf,image/png,image/jpeg,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet

# The virus scanner (FR-ATT-001, FR-ATT-002, #246).
#
# **There is no setting that turns scanning off.** An unreachable scanner leaves
# every attachment PENDING, and a PENDING attachment cannot be downloaded — so a
# deployment that loses its scanner stops serving files rather than starting to
# serve unscanned ones. A flag saying "skip the scan" would be a flag saying
# "serve unscanned bytes", and no deployment should be one setting away from it.
#
# **Sized 2026-08-31 rather than guessed** (#246): ClamAV holds ~1 GB resident,
# almost all of it the signature set, scans 25 MiB in ~169 ms, and gains nothing
# from concurrency — one instance is the whole answer, and a worker concurrency
# of 2-4 is as much as it can use.
KELIR_CLAMAV_HOST=localhost
KELIR_CLAMAV_PORT=3310

# How long an uploaded file waits before anything looks at it. A poll rather
# than a queue, because the queue this wants is the outbox and the outbox is
# Phase 8; the cost is latency bounded by this number, and the benefit is that a
# scan interrupted by a restart is simply picked up again.
KELIR_CLAMAV_POLL_SECONDS=5
KELIR_SMTP_HOST=localhost
# The sender on outbound mail -- today only the password-reset link (FR-AUTH-006).
# An empty KELIR_SMTP_HOST turns sending into a log line rather than a startup
# failure, so a deployment without a mail server still runs.
KELIR_MAIL_FROM=no-reply@kelir.local
# Reset links are built against this, so it must be the address a person's
# browser can actually reach.
KELIR_FRONTEND_URL=http://localhost:5173

# Tenancy (FR-IDM-009, FR-ORG-001). Off, sign-in resolves
# KELIR_DEFAULT_TENANT_CODE, a tenant code sent by a caller is IGNORED rather
# than obeyed, and the login form shows no tenant field — the single-tenant
# default. On, each sign-in must name its tenant, and that tenant must exist and
# be ACTIVE; the login form learns which mode this is from GET /deployment.
#
# The default code must match a row in `tenants`; SYSTEM is the one 0001_core.sql
# seeds. Pointing it at a tenant that does not exist fails startup rather than
# silently creating the first administrator somewhere else.
#
# KELIR_DEFAULT_TENANT_CODE also names the tenant that ADMINISTERS tenants: the
# first-run administrator is created in it, and it is the only tenant from which
# POST/PUT/DELETE /api/v1/organization/tenants is accepted. A tenant created
# through that surface gets its own administrator, who runs that tenant and
# cannot create others.
#
# Turning the mode on is a one-way door in practice: existing users live in the
# default tenant and will need its code at the login form from then on. Decision
# D-18 (superseding D-7) is where this was settled; the backend used to refuse
# to start with the mode on and no longer does.
KELIR_MULTI_TENANT=false
KELIR_DEFAULT_TENANT_CODE=SYSTEM


# How many reverse-proxy hops sit in front of the backend.
#
# 0 — the default, and what a direct local run wants — ignores X-Forwarded-For
# entirely and takes the caller's address from the socket. Anything higher tells
# the backend to skip that many hops from the right of the chain and believe the
# entry before them, so it must match the real topology: set 1 only when exactly
# one proxy you operate can reach the backend. Too high and a caller can pick
# their own address, which is their own rate-limit bucket and their own line in
# the audit trail.
KELIR_TRUSTED_PROXY_HOPS=0

# First administrator. Created once, at startup, only when the `users` table is
# empty — a fresh database otherwise has every permission defined and nobody
# able to use them. Both values are required together; leaving them unset is
# fine if the first user will be created another way. The password is held to
# the same 12-character minimum as every password the API sets, and the account
# it creates must change it after signing in. Unset all three once the first
# sign-in has succeeded.
KELIR_BOOTSTRAP_ADMIN_USERNAME=admin
KELIR_BOOTSTRAP_ADMIN_PASSWORD=
KELIR_BOOTSTRAP_ADMIN_EMAIL=admin@localhost

# Frontend
VITE_KELIR_API_BASE_URL=http://localhost:8080/api/v1
VITE_KELIR_APP_TITLE=Kelir

# Compose host ports
#
# Only the host side is configurable; container ports are fixed. Override these
# when another project already holds a port — the defaults below are what the
# stack uses when nothing is set. Compose reads these from the environment or
# from a .env file next to docker-compose.yml, not from this file.
KELIR_FRONTEND_PORT=5173
KELIR_BACKEND_PORT=8080
KELIR_POSTGRES_PORT=5432
KELIR_MINIO_PORT=9000
KELIR_MINIO_CONSOLE_PORT=9001
# Doubles as the backend's connect port: a backend run natively against this
# file reaches mailpit on localhost at whatever the host mapping publishes.
KELIR_SMTP_PORT=1025
KELIR_MAILPIT_UI_PORT=8025
