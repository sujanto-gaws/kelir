# Rust
target/
**/*.rs.bk

# Node / frontend
node_modules/
dist/
.vite/
*.tsbuildinfo
npm-debug.log*
pnpm-debug.log*
yarn-error.log*

# Test / coverage
coverage/
.nyc_output/

# End-to-end harness output (e2e/). Reports, traces, screenshots and video are
# artifacts of a run, uploaded by CI when a run fails; none of them is source.
test-results/
playwright-report/
blob-report/
.playwright/

# Env
# Real env files never; the *.example templates always. The second negation
# covers per-environment templates such as .env.staging.example, which the
# first does not match.
.env
.env.*
!.env.example
!.env.*.example

# Logs
*.log
logs/

# Local data (docker volumes, object storage, db dumps)
deploy/docker/data/
*.dump

# OS
.DS_Store
Thumbs.db
desktop.ini

# Editor / tooling
.vscode/
.idea/
.claude/settings.local.json
# Per-machine agent settings: experimental env flags, terminal preferences and
# plugin toggles, which belong to whoever is sitting at the machine rather than
# to the project. `settings.local.json` above was already ignored; this file
# holds the same kind of value and was not, so it showed as untracked noise in
# every `git status`.
.claude/settings.json
# A GitHub credential, kept beside the agent configuration so the tooling can
# find it. It is ignored here because the cost of the alternative is not a
# messy `git status` but a live token on a public remote, and `git add -A` from
# any session in this checkout is all it would take.
.claude/.github-token
# Scratch git worktrees the agent tooling creates. `.claude/agents/` and the
# skills beside it are shared project configuration and stay tracked.
.claude/worktrees/
