# Rust
target/
**/*.rs.bk

# Node / frontend
node_modules/
dist/
.vite/
*.tsbuildinfo
npm-debug.log*
pnpm-debug.log*
yarn-error.log*

# Test / coverage
coverage/
.nyc_output/

# Env
# Real env files never; the *.example templates always. The second negation
# covers per-environment templates such as .env.staging.example, which the
# first does not match.
.env
.env.*
!.env.example
!.env.*.example

# Logs
*.log
logs/

# Local data (docker volumes, object storage, db dumps)
deploy/docker/data/
*.dump

# OS
.DS_Store
Thumbs.db
desktop.ini

# Editor / tooling
.vscode/
.idea/
.claude/settings.local.json
# Scratch git worktrees the agent tooling creates. `.claude/agents/` and the
# skills beside it are shared project configuration and stay tracked.
.claude/worktrees/
